# Groq API key for AI-driven loan decisions
GROQ_API_KEY=your_groq_api_key_here

# SimpleDispute contract address (deployed on your blockchain network)
SIMPLE_DISPUTE_ADDRESS=0xYourDeployedContractAddress

# DecisionHashRegistry contract address (deployed on your blockchain network)
REGISTRY_ADDRESS=0xYourDeployedRegistryAddress

# Blockchain RPC URL (e.g., Hardhat local node, Sepolia, etc.)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545

# Private key for automation wallet (used for automated on-chain challenges)
AUTOMATION_PRIVATE_KEY=0xYourPrivateKey

# Public address of the automation wallet
AUTOMATION_WALLET_ADDRESS=0xYourWalletAddress

# Firebase service account JSON (for production admin features)
# Alternatively, use application default credentials
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Server port (optional, defaults to 5000)
PORT=5000