# SimpleDispute contract address (deployed on your blockchain network)
VITE_SIMPLE_DISPUTE_ADDRESS=0xYourDeployedContractAddress

# Challenge stake amount in ETH
VITE_CHALLENGE_STAKE_ETH=0.001

# Backend API URL
VITE_API_URL=http://localhost:5000

# Your Firebase config (copy from Firebase Console -> Project Settings -> Web App)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id