# Backend API URL (default: http://localhost:5000)
VITE_API_URL=http://localhost:5000

# SimpleDispute contract address (deployed on your blockchain network)
# Used for committing decisions and challenges
VITE_SIMPLE_DISPUTE_ADDRESS=0xYourDeployedContractAddress

# DecisionHashRegistry contract address (deployed on your blockchain network)
# Used for immutable hash anchoring
VITE_REGISTRY_ADDRESS=0xYourDeployedRegistryAddress

# Minimum challenge stake in ETH (default: 0.001)
VITE_CHALLENGE_STAKE_ETH=0.001