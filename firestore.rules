rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);

      match /applications/{applicationId} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.token.admin == true);
      }
    }

    // QR visitors can read only the hash, never an application or applicant data.
    match /publicVerifications/{applicationId} {
      allow read: if true;
      allow create: if true; // Allow anyone to create public verification records
      allow update, delete: if false;
    }
  }
}
